# ── FolioFYX backend environment ──────────────────────────────────────────────
# Copy to ./server/.env and fill in real values. NEVER commit the real .env.

# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB connection string — e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/foliofyx

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# AI (Groq) — server-side ONLY. Keys are never sent to the browser.
# Preferred: several keys, comma-separated — the pool rotates across them and
# fails over on rate limits so simultaneous users never stall.
GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three
# Legacy single key (still works; merged into the pool):
GROQ_API_KEY=gsk_your_groq_api_key_here

# Python interpreter for the RAG engine + CV scripts (defaults to "python" on PATH)
# PYTHON_BIN=python

# ── Published sites & domains ──────────────────────────────────────────────────
# Product domain; free sites live at <slug>.<ROOT_DOMAIN>.
# ROOT_DOMAIN=foliofyx.in
# Serve <slug>.<ROOT_DOMAIN> (needs the *.foliofyx.in wildcard DNS + wildcard
# domain added on Render). Set to false until that is configured.
# WILDCARD_SUBDOMAINS=true
# Origin that serves /site/<slug> (defaults to RENDER_EXTERNAL_HOSTNAME, which
# Render sets automatically, then the request host).
# PUBLIC_SITE_BASE=https://foliofyx-backend.onrender.com
# What users point CNAME records at (defaults to RENDER_EXTERNAL_HOSTNAME).
# SITE_CNAME_TARGET=foliofyx-backend.onrender.com
# What users point apex A records at (Render's load balancer by default).
# SITE_APEX_IP=216.24.57.1
# Render API access so connected domains are added to the service and get
# automatic SSL (Account settings → API keys; service id starts with "srv-").
# RENDER_API_KEY=rnd_xxx
# RENDER_SERVICE_ID=srv-xxx
# Set to "off" to disable the background custom-domain re-checks.
# DOMAIN_MONITOR=on

# Any other integrations your deploy uses (payments, Google auth, etc.)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GOOGLE_CLIENT_ID=
